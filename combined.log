  "invitation": {
    "id": 12,
    "title_en": "World Tamil Siragam Inaugural Invitation - 2023",
    "title_ta": "உலகத் தமிழ்ச் சிறகம் தொடக்க விழா அழைப்பிதழ்-2023",
    "description_en": "The World Tamil Flag Organization was launched on September 23, 2023, with its headquarters in Paris, France, to unite international Tamils",
    "description_ta": "பன்னாட்டு தமிழர்களை ஒன்றிணைத்து உலகத் தமிழ்ச் சிறகம் அமைப்பானது பிரான்சு நாட்டின் பாரீசு நகரை தலைமையிடமாகக்கொண்டு 2023 ஆம் ஆண்டு செப்டம்பர் மாதம் 23ஆம் தேதி தொடங்கப்பட்டது",
    "date_en": "2023-09-23",
    "date_ta": "2023-09-23",
    "location_en": "Venue - Gymnase Victor Hugo, Rue Renoir, 95140 Garges les Gonesse",
    "location_ta": "இடம் - ஜிம்னாஸ் விக்டர் ஹ்யூகோ, ரூ ரெனோயர், 95140 கார்கெஸ் லெஸ் கோனெஸ்ஸி",
    "sub_description_en": "We warmly welcome you all!!",
    "sub_description_ta": "உங்களை அனைவரையும் அன்புடன் வரவேற்கின்றோம்!!",
    "image": "image-1753093345699.jpg",
